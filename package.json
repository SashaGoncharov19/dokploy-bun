{
	"name": "dokploy",
	"private": true,
	"workspaces": [
		"apps/*",
		"packages/*"
	],
	"scripts": {
		"dokploy:setup": "bun run --filter dokploy setup",
		"dokploy:dev": "bun run --filter dokploy dev",
		"dokploy:build": "bun run --filter dokploy build",
		"dokploy:start": "bun run --filter dokploy start",
		"test": "bun run --filter dokploy test",
		"docker:build:canary": "./apps/dokploy/docker/build.sh canary",
		"typecheck": "bun run --filter '*' typecheck",
		"build": "bun run --filter '*' build",
		"format-and-lint": "biome check .",
		"check": "biome check --write --no-errors-on-unmatched --files-ignore-unknown=true",
		"format-and-lint:fix": "biome check . --write",
		"generate:openapi": "bun run --filter dokploy generate:openapi"
	},
	"devDependencies": {
		"@biomejs/biome": "2.5.7",
		"@types/node": "^24.4.0",
		"dotenv": "16.4.5",
		"lint-staged": "^15.5.2"
	},
	"engines": {
		"bun": ">=1.3.14"
	},
	"lint-staged": {
		"*": [
			"biome check --write --no-errors-on-unmatched --files-ignore-unknown=true"
		]
	},
	"overrides": {
		"@types/react": "18.3.5",
		"@types/react-dom": "18.3.0",
		"esbuild": "0.20.2",
		"better-call": "1.3.7",
		"@better-fetch/fetch": "1.3.1",
		"@codemirror/view": "6.43.6",
		"tar": ">=7.5.19 <8.0.0",
		"protobufjs": ">=7.5.5 <8.0.0",
		"js-yaml": ">=4.3.2 <5.0.0",
		"mysql2": ">=3.23.1 <4.0.0",
		"deepmerge-ts": ">=8.0.0 <9.0.0",
		"@ai-sdk/provider-utils": ">=4.0.33 <5.0.0",
		"hono": ">=4.13.11 <5.0.0",
		"lodash": "4.18.1",
		"postcss": ">=8.5.23 <9.0.0",
		"effect": ">=3.20.0 <4.0.0",
		"h3": ">=1.15.9 <2.0.0",
		"tar-fs": ">=2.1.4 <3.0.0",
		"uuid": ">=11.1.1 <12.0.0",
		"valibot": ">=1.4.2 <2.0.0",
		"proxy-addr": ">=2.0.8 <3.0.0",
		"axios": ">=1.20.0 <2.0.0",
		"source-map-js": ">=1.2.2 <2.0.0",
		"ip-address": ">=10.7.4 <11.0.0",
		"vite": ">=7.3.7 <8.0.0",
		"@vitest/mocker": ">=4.1.12 <5.0.0",
		"follow-redirects": ">=1.16.2 <2.0.0",
		"http-cache-semantics": ">=4.3.0 <5.0.0",
		"postcss-selector-parser": ">=7.1.6 <8.0.0",
		"sharp": ">=0.35.5 <0.36.0",
		"@modelcontextprotocol/sdk": ">=1.31.0 <2.0.0",
		"fast-copy": ">=3.1.0 <4.0.0",
		"systeminformation": ">=5.33.16 <6.0.0",
		"qs": ">=6.16.1 <7.0.0"
	},
	"trustedDependencies": [
		"@scarf/scarf",
		"better-sqlite3",
		"core-js-pure",
		"cpu-features",
		"esbuild",
		"msgpackr-extract",
		"protobufjs",
		"sharp",
		"ssh2"
	]
}
